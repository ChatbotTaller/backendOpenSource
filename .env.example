# Copia este archivo como .env para desarrollo local.
# Nunca coloques secretos reales en .env.example ni lo uses como archivo de producción.

# Aplicación
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:4200,https://tu-frontend.vercel.app

# MySQL (usa las credenciales suministradas por Railway o una base local de pruebas)
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=
DB_CONNECTION_LIMIT=5
DB_MAX_IDLE=5
# Alternativas aceptadas automáticamente en Railway:
# MYSQLHOST, MYSQLPORT, MYSQLUSER, MYSQLPASSWORD, MYSQLDATABASE.
# DB_PASSWORD también se acepta como alias de DB_PASS. No configures ambos grupos.

# Seguridad
# Usa valores aleatorios, largos y diferentes entre sí. No reutilices estos secretos.
JWT_SECRET=
VOICE_SERVICE_TOKEN=

# Chatbot e identificación por DNI
OPENAI_API_KEY=
APIPERU_TOKEN=

# Voz: LiveKit + Simli
ENABLE_LIVEKIT=true
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
SIMLI_API_KEY=
SIMLI_FACE_ID=
# Desarrollo local del agente Simli:
BACKEND_URL=http://localhost:3000/webhook/voice
# En Railway (servicio simli-agent), usa la URL HTTPS pública terminada en /webhook/voice.
# VOICE_SERVICE_TOKEN debe tener exactamente el mismo valor en backendOpenSource y simli-agent.

# Google Calendar/OAuth (opcional)
# Deben contener JSON válido serializado en una sola línea.
GOOGLE_CREDENTIALS_JSON=
GOOGLE_TOKEN_JSON=

# Integraciones legacy: permanecen deshabilitadas salvo que se utilicen expresamente
ENABLE_RETELL=false
RETELL_API_KEY=
RETELL_AGENT_ID=
ENABLE_WHATSAPP=false
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Creación manual de un administrador (solo para ejecutar crearAdmin.js)
ADMIN_USER=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador

# Pruebas de carga locales (no usar credenciales reales de administración)
LOAD_BASE_URL=http://localhost:3000
LOAD_ADMIN_USER=
LOAD_ADMIN_PASSWORD=
LOAD_DNI=
LOAD_CLIENT_SESSION=
LOAD_PROFILE=normal
